# Secrets — never commit these
.env
.env.*
!.env.prod.example

# Helm secret overrides — real credentials go here, never committed
# Pattern: values.dev.secret.yaml, values.staging.secret.yaml, etc.
infra/helm/vidya/values.*.secret.yaml

# Kubernetes manifests that contain real credentials
# Examples: secret-store-vault.yaml (with token), tls.yaml (with cert)
infra/k8s/*.secret.yaml

# Python artefacts
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

# Session temp files — commit messages written by PowerShell git workflow
commit_msg_*.txt
commitmsg_*.txt

# Local backup files — never commit these (may contain DB dumps)
infra/backups/

# k6 load test result files — generated locally, not committed
infra/load-tests/results/*.json

# Generated presentation artifacts (M03 course-kit PPTX export renders these
# locally during development). Build output, never source.
*.pptx
