    {
      "id": 7,
      "type": "timeseries",
      "title": "Dependency Health Timeline",
      "description": "All service health values over time. 1=healthy (green), 0=unhealthy (red), -1=skipped (grey). API must be running to populate these metrics.",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "vidya-prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "short",
          "min": -1.5,
          "max": 1.5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
