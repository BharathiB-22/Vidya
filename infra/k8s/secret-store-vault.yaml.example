# =============================================================================
# secret-store-vault.yaml.example  —  Vault SecretStore / ClusterSecretStore
# =============================================================================
#
# PURPOSE
# -------
# Connects the External Secrets Operator (ESO) to HashiCorp Vault so that
# the ExternalSecret in infra/helm/vidya/templates/externalsecret.yaml can
# pull secrets from Vault KV v2.
#
# TWO VARIANTS PROVIDED
# ─────────────────────
# Variant A: SecretStore (namespaced — use for STAGING)
#   Scoped to the vidya-system namespace. Referenced by ExternalSecrets in
#   the same namespace. Set externalSecrets.storeKind: SecretStore in
#   values.staging.yaml.
#
# Variant B: ClusterSecretStore (cluster-wide — use for PROD)
#   Referenced by ExternalSecrets in any namespace. Set
#   externalSecrets.storeKind: ClusterSecretStore in values.prod.yaml.
#
# USE ONE VARIANT PER CLUSTER, NOT BOTH.
# Copy the relevant section into secret-store-vault.yaml (gitignored).
#
# PREREQUISITES
# -------------
# Run infra/k8s/vault-init.sh before applying this file. It handles:
#   1. vault secrets enable -path=secret kv-v2
#   2. vault auth enable kubernetes
#   3. vault write auth/kubernetes/config kubernetes_host=...
#   4. vault policy write vidya-read (path "secret/data/vidya/*" read)
#   5. vault write auth/kubernetes/role/vidya (SA: vidya, NS: vidya-system)
#
# VAULT KV PATH LAYOUT
# --------------------
# All secrets for one environment live in a single KV v2 entry:
#   Staging:  secret/data/vidya/staging   (all fields)
#   Prod:     secret/data/vidya/prod      (all fields)
#
# Required fields in each KV entry:
#   DATABASE_URL, POSTGRES_PASSWORD, REDIS_URL, REDIS_PASSWORD,
#   JWT_SECRET, EXAM_FERNET_KEY, S3_ACCESS_KEY, S3_SECRET_KEY,
#   GEMINI_API_KEY, GROQ_API_KEY, SMTP_PASSWORD,
#   FLOWER_USER, FLOWER_PASSWORD, YOUTUBE_API_KEY
#
# Populate with Vault CLI (or use vault-init.sh):
#   vault kv put secret/vidya/staging \
#     DATABASE_URL="postgresql+asyncpg://vidya:<pass>@db-host:5432/vidya" \
#     JWT_SECRET="<64-char-hex>" \
#     EXAM_FERNET_KEY="<fernet-key>" \
#     ...
#
# GHCR IMAGE PULL SECRET (required for private ghcr.io images)
# ─────────────────────────────────────────────────────────────
# Covered by vault-init.sh Section 6. Or manually:
#   kubectl create secret docker-registry ghcr-pull-secret \
#     --docker-server=ghcr.io \
#     --docker-username=BharathiB-22 \
#     --docker-password=<github-pat-with-read:packages> \
#     -n vidya-system
#
# Then in values.staging.yaml / values.prod.yaml:
#   global:
#     imagePullSecrets:
#       - name: ghcr-pull-secret
#
# ESO HEALTH VERIFICATION
# ───────────────────────
# After applying and running helm install:
#   kubectl describe externalsecret vidya-secret -n vidya-system
#   # Expect: Status.Conditions[0].Type=Ready, Reason=SecretSynced
#
#   kubectl get secret vidya-secret -n vidya-system \
#     -o jsonpath='{.data.JWT_SECRET}' | base64 -d | head -c 8
#   # Expect: first 8 chars of your JWT_SECRET (non-empty, not JSON blob)
#
# VAULT OUTAGE BEHAVIOUR
# ──────────────────────
# - Running pods: UNAFFECTED. Pods read secrets from the Kubernetes Secret
#   (vidya-secret) at startup. They do not query Vault directly. A Vault
#   outage does not restart or crash running pods.
# - ESO refresh: Will fail silently. ESO logs "SecretSynced=False" but does
#   NOT delete or modify the existing Kubernetes Secret. The stale Secret
#   continues to work until the TTL-based refresh next succeeds.
# - New pod starts: Use the existing Kubernetes Secret (cached). Safe.
# - helm upgrade during outage: Secret update will fail (ESO cannot pull
#   new values). Do NOT run helm upgrade that changes secrets during an outage.
# - Recovery: Once Vault is reachable, ESO re-syncs automatically within
#   one refreshInterval (1h). Force immediate re-sync:
#     kubectl annotate externalsecret vidya-secret \
#       force-sync=$(date +%s) -n vidya-system
#
# AWS SECRETS MANAGER VARIANT
# ───────────────────────────
# Replace the vault: provider block with:
#   aws:
#     service: SecretsManager
#     region: ap-south-1
#     auth:
#       jwt:
#         serviceAccountRef:
#           name: vidya
#           namespace: vidya-system
# Each remoteRef key in externalsecret.yaml must be the AWS secret name.
#
# GCP SECRET MANAGER VARIANT
# ──────────────────────────
# Replace the vault: provider block with:
#   gcpsm:
#     projectID: your-gcp-project-id
#     auth:
#       workloadIdentity:
#         clusterLocation: asia-south1
#         clusterName: vidya-prod
#         clusterProjectID: your-gcp-project-id
#         serviceAccountRef:
#           name: vidya
#           namespace: vidya-system
# =============================================================================

# =============================================================================
# VARIANT A — SecretStore (namespaced, STAGING)
# Apply: kubectl apply -f secret-store-vault.yaml -n vidya-system
# values.staging.yaml: externalSecrets.storeKind: SecretStore
# =============================================================================
apiVersion: external-secrets.io/v1beta1
kind: SecretStore
metadata:
  name: vidya-secret-store
  namespace: vidya-system
spec:
  provider:
    vault:
      # CHANGE_ME: Vault server address (accessible from the cluster)
      # Examples: "http://vault.internal:8200"  or  "https://vault.staging.fidelitus.com"
      server: "CHANGE_ME_vault_address"

      # KV v2 mount path (default is "secret" in most Vault installations)
      path: "secret"
      version: "v2"

      auth:
        kubernetes:
          mountPath: "kubernetes"
          # Vault role created by vault-init.sh (bound to SA vidya, NS vidya-system)
          role: "vidya"
          serviceAccountRef:
            name: vidya
            namespace: vidya-system

---
# =============================================================================
# VARIANT B — ClusterSecretStore (cluster-wide, PROD)
# Apply: kubectl apply -f secret-store-vault.yaml   (no -n flag — cluster-scoped)
# values.prod.yaml: externalSecrets.storeKind: ClusterSecretStore
# =============================================================================
# apiVersion: external-secrets.io/v1beta1
# kind: ClusterSecretStore
# metadata:
#   name: vidya-secret-store
#   # ClusterSecretStore is cluster-scoped; no namespace field.
# spec:
#   provider:
#     vault:
#       server: "CHANGE_ME_vault_address"
#       path: "secret"
#       version: "v2"
#       auth:
#         kubernetes:
#           mountPath: "kubernetes"
#           role: "vidya"
#           serviceAccountRef:
#             name: vidya
#             namespace: vidya-system
