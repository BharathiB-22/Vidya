# =============================================================================
# secret-store-vault.yaml.example  —  Vault ClusterSecretStore for ESO
# =============================================================================
#
# PURPOSE
# -------
# Connects the External Secrets Operator (ESO) to HashiCorp Vault so that
# ExternalSecret resources in the Helm chart can pull secrets from Vault KV.
#
# USAGE
# -----
# 1. Install ESO:
#      helm repo add external-secrets https://charts.external-secrets.io
#      helm install external-secrets external-secrets/external-secrets \
#        -n external-secrets --create-namespace
#
# 2. Configure Vault (run once per environment):
#    a. Enable Kubernetes auth:
#         vault auth enable kubernetes
#         vault write auth/kubernetes/config \
#           kubernetes_host="https://<cluster-api-server>:6443"
#    b. Create Vault policy (vidya-read):
#         vault policy write vidya-read - <<EOF
#         path "secret/data/vidya/*" { capabilities = ["read"] }
#         EOF
#    c. Create Vault role binding the service account:
#         vault write auth/kubernetes/role/vidya \
#           bound_service_account_names=vidya \
#           bound_service_account_namespaces=vidya-system \
#           policies=vidya-read \
#           ttl=1h
#
# 3. Copy this file and fill in CHANGE_ME values:
#      cp secret-store-vault.yaml.example secret-store-vault.yaml
#      # edit VAULT_ADDRESS and VAULT_KUBERNETES_ROLE below
#
# 4. Apply to the cluster:
#      kubectl apply -f infra/k8s/secret-store-vault.yaml -n vidya-system
#      kubectl get clustersecretstore vidya-secret-store   # must show Ready=True
#
# VAULT KV PATH LAYOUT
# --------------------
# Staging:  secret/data/vidya/staging/<secret-name>
# Prod:     secret/data/vidya/prod/<secret-name>
#
# Required secrets (matching keys in infra/helm/vidya/templates/secret.yaml):
#   DATABASE_URL, POSTGRES_PASSWORD, REDIS_URL, REDIS_PASSWORD,
#   JWT_SECRET, EXAM_FERNET_KEY, S3_ACCESS_KEY, S3_SECRET_KEY,
#   GEMINI_API_KEY, GROQ_API_KEY, SMTP_PASSWORD,
#   FLOWER_USER, FLOWER_PASSWORD, YOUTUBE_API_KEY
#
# Example (Vault CLI):
#   vault kv put secret/vidya/staging/database-url \
#     DATABASE_URL="postgresql+asyncpg://vidya:<pass>@pg-host:5432/vidya"
#
# AWS SECRETS MANAGER VARIANT (delta from Vault config below)
# -----------------------------------------------------------
# Replace the `vault:` provider block with:
#   aws:
#     service: SecretsManager
#     region: ap-south-1
#     auth:
#       jwt:
#         serviceAccountRef:
#           name: vidya
# Secret names in AWS SM follow the remoteKeyPrefix in values.yaml:
#   "vidya/prod/database-url"  →  value field: DATABASE_URL
#
# GCP SECRET MANAGER VARIANT
# --------------------------
# Replace the `vault:` provider block with:
#   gcpsm:
#     projectID: your-gcp-project-id
#     auth:
#       workloadIdentity:
#         clusterLocation: asia-south1
#         clusterName: vidya-prod
#         clusterProjectID: your-gcp-project-id
#         serviceAccountRef:
#           name: vidya
# =============================================================================

apiVersion: external-secrets.io/v1beta1
kind: ClusterSecretStore
metadata:
  name: vidya-secret-store
  # ClusterSecretStore is cluster-scoped; namespace field is ignored here.
  # The ExternalSecrets in vidya-system namespace reference this store by name.
spec:
  provider:
    vault:
      # CHANGE_ME: replace with your Vault server address
      # Staging example:  "http://vault.internal:8200"
      # Prod example:     "https://vault.prod.fidelitus.com"
      server: "CHANGE_ME_vault_address"

      # KV v2 mount path (default is "secret" in dev Vault)
      path: "secret"
      version: "v2"

      auth:
        kubernetes:
          # The Kubernetes auth mount path configured in step 2a above.
          mountPath: "kubernetes"

          # CHANGE_ME: Vault role created in step 2c above.
          role: "vidya"

          # ESO uses the Helm chart's ServiceAccount (created by serviceaccount.yaml)
          # to authenticate to Vault. The SA name defaults to the Helm release name.
          serviceAccountRef:
            name: vidya
            namespace: vidya-system
