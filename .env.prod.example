# ============================================================
# Vidya — Production Environment Variables
# ============================================================
# Copy this file to .env.prod and fill in every REQUIRED value.
# NEVER commit .env.prod — it is listed in .gitignore.
#
# Generate secrets:
#   JWT_SECRET:      python -c "import secrets; print(secrets.token_hex(32))"
#   EXAM_FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Passwords:       python -c "import secrets; print(secrets.token_urlsafe(24))"
# ============================================================

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED — must match the Postgres service environment variables.
POSTGRES_USER=vidya
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=vidya
DATABASE_URL=postgresql+asyncpg://vidya:CHANGE_ME_strong_password@postgres:5432/vidya

# ── Redis ─────────────────────────────────────────────────────────────────────
# REQUIRED — set a strong password; used in Redis AUTH and the Celery broker URL.
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_with_script_above
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Object Storage (MinIO) ────────────────────────────────────────────────────
# REQUIRED — must not be the default minioadmin values.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=CHANGE_ME_minio_access_key
S3_SECRET_KEY=CHANGE_ME_minio_secret_key
S3_BUCKET=vidya-assets
S3_USE_SSL=False   # Set True if using a TLS-terminated MinIO endpoint

# ── CORS ─────────────────────────────────────────────────────────────────────
# REQUIRED — set to the exact origin(s) of your frontend deployment.
# Comma-separated list, e.g.:
#   CORS_ALLOWED_ORIGINS=https://app.vidya.example,https://admin.vidya.example
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_your_frontend_domain

# ── Exam Paper Encryption ─────────────────────────────────────────────────────
# REQUIRED — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store this key in your secrets manager (Vault, KMS).  Loss of this key
# makes sealed exam papers permanently irrecoverable.
EXAM_FERNET_KEY=CHANGE_ME_generate_with_script_above

# ── AI Provider ───────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME_your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=CHANGE_ME_smtp_host
SMTP_PORT=587
SMTP_USER=CHANGE_ME_smtp_user
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM=noreply@CHANGE_ME_your_domain
SMTP_TLS=True
EMAIL_NOTIFICATIONS_ENABLED=True

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
JSON_LOGGING=True

# ── Storage ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── Flower (Celery monitor) ───────────────────────────────────────────────────
FLOWER_USER=CHANGE_ME_flower_user
FLOWER_PASSWORD=CHANGE_ME_flower_password

# ── Research / Viva ───────────────────────────────────────────────────────────
# Set to the Whisper ASR service endpoint when available.
# Leave blank to use mock transcription (development only).
M07_WHISPER_ENDPOINT=

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ── External APIs ─────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=CHANGE_ME_youtube_api_key
