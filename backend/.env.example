# Copy this file to .env and fill in real values.
# Never commit .env to version control.

DATABASE_URL=postgresql+asyncpg://vidya:vidya_dev@localhost:5432/vidya
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
ENVIRONMENT=development

# AI provider selection: groq | gemini | fallback
AI_PROVIDER=groq

# AI provider keys (only the active provider's key is required)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=vidya-assets

# Thresholds
AI_DETECTION_THRESH=0.75
PLAGIARISM_THRESH=0.85
